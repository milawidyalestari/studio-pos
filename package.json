{
  "name": "studio-pos",
  "private": true,
  "version": "1.0.0",
  "description": "Studio POS - Point of Sale System for Digital Printing",
  "author": "Studio POS Team",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --config vite.electron.config.ts",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "setup:db": "node scripts/setup-database.js",
    "migrate:export": "node scripts/export-supabase-data.js",
    "migrate:import": "node scripts/import-to-local.js",
    "migrate:full": "npm run migrate:export && npm run migrate:import",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev:electron\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:start": "cross-env NODE_ENV=development electron start-electron.js",
    "electron:test": "cross-env NODE_ENV=development electron test-electron.js",
    "electron:build": "cross-env NODE_ENV=production npm run build && electron-builder",
    "electron:dist": "cross-env NODE_ENV=production npm run build && electron-builder --publish=never",
    "electron:dev:hot": "concurrently \"npm run dev:electron\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron . --dev\"",
    "electron:dev:debug": "cross-env NODE_ENV=development electron . --inspect=5858",
    "electron:dev:reload": "concurrently \"npm run dev:electron\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron . --enable-logging\"",
    "native:dev": "npm run electron:dev",
    "native:dev:transparent": "cross-env WINDOW_TYPE=transparent npm run electron:dev",
    "test:splash": "node scripts/test-splash-screen.js",
    "test:splash:glassmorphism": "electron test-splash-glassmorphism.js",
    "test:splash:white": "electron test-splash-white.js",
    "test:splash:clean": "electron test-splash-clean.js",
    "generate:icons": "node scripts/generate-icons.js",
    "build:with-splash": "npm run build && npm run electron:dist",
    "build:installer": "npm run build && npm run electron:dist",
    "build:installer:clean": "npm run clean && npm run build:installer",
    "clean": "rimraf dist build-output",
    "native:dev:frameless": "cross-env WINDOW_TYPE=frameless npm run electron:dev",
    "native:dev:standard": "cross-env WINDOW_TYPE=standard npm run electron:dev",
    "native:build": "cross-env NODE_ENV=production npm run build && npm run electron:build",
    "native:build:win": "cross-env NODE_ENV=production npm run build && electron-builder --win",
    "native:build:mac": "cross-env NODE_ENV=production npm run build && electron-builder --mac",
    "native:build:linux": "cross-env NODE_ENV=production npm run build && electron-builder --linux",
    "build:complete": "scripts\\build-complete.bat",
    "build:production": "scripts\\build-production.bat",
    "build:distribution": "scripts\\build_complete_distribution.bat",
    "create:distribution": "scripts\\create_distribution.bat",
    "test:distribution": "scripts\\test_distribution.bat",
    "build:test": "scripts\\build_and_test.bat",
    "check:production": "node scripts/check-production-mode.js",
    "test:app": "node scripts/test-app.js",
    "test:installation": "scripts\\test-installation-flow.bat",
    "test:login": "node scripts/test-login.js",
    "test:ipc": "node scripts/test-ipc-handlers.js",
    "test:installer": "scripts\\test-installer.bat",
    "test:cashdrawer": "node scripts/test-cash-drawer.js",
    "install:cashdrawer": "scripts\\install-cash-drawer-deps.bat",
    "clean:rebuild": "scripts\\clean-rebuild.bat",
    "fix:taskbar-icon": "node scripts/fix-taskbar-icon.js",
    "test:taskbar-icon": "node scripts/test-taskbar-icon.js",
    "replace-icon": "node scripts/replace-icon.js",
    "icon-guide": "node scripts/replace-icon-guide.js",
    "fix-taskbar-issue": "node scripts/fix-taskbar-icon-issue.js",
    "diagnose-icon": "node scripts/diagnose-taskbar-icon.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@supabase/supabase-js": "^2.54.0",
    "@tanstack/react-query": "^5.56.2",
    "@types/react-beautiful-dnd": "^13.1.8",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "dayjs": "^1.11.13",
    "embla-carousel-react": "^8.3.0",
    "html2canvas": "^1.4.1",
    "input-otp": "^1.2.4",
    "jsdom": "^26.1.0",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-resizable-panels": "^2.1.3",
    "react-router-dom": "^6.26.2",
    "react-select": "^5.10.2",
    "recharts": "^2.12.7",
    "sonner": "^1.5.0",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^10.0.0",
    "electron": "^37.2.5",
    "electron-builder": "^26.0.12",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "lovable-tagger": "^1.1.8",
    "postcss": "^8.4.47",
    "sharp": "^0.34.4",
    "supabase": "^2.53.6",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "wait-on": "^7.2.0"
  }
}
